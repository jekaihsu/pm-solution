# Lark / 飛書開放平台自建應用的憑證（開發者後台 → 憑證與基礎資訊）
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API 網域：Lark 國際版用 https://open.larksuite.com ，飛書用 https://open.feishu.cn
LARK_API_BASE=https://open.larksuite.com

# 各報告讀取哪個 Base / 資料表 / 視圖設定在 lib/reports.ts（ID 不是機密）

# （選填）伺服器端快取秒數，避免頻繁打 Lark API（預設 30）
CACHE_TTL_SECONDS=30

# 登入：設定 LARK_APP_ID / LARK_APP_SECRET 後，整站需以 Lark 帳號登入
# （選填）網站對外網址，用於 OAuth 回呼；未設定時依請求自動判斷
APP_URL=
# （選填）只允許此組織（tenant_key）的帳號登入
LARK_TENANT_KEY=
# （選填）簽署登入 cookie 的密鑰；未設定時由 App Secret 衍生
SESSION_SECRET=
